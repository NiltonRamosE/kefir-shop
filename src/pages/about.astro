---
import AboutPage from '@/project/about/AboutPage';
import ProtectedLayout from '@/layouts/ProtectedLayout.astro';
const robots = ["index", "follow"];
const title = "Kefir Shop | Nosotros";
const description = "Productos disponibles en la tienda virtual de KéfirShop";
const keywords = ["Kefir", "Yogurt", "Búlgaros", "Probióticos", "Sin Lactosa"];
const url = "https://kefir-shop.vercel.app/about";
const imageOG = "/favicon.svg";
const imagetwt = "/favicon.svg";
---

<ProtectedLayout {robots} {title} {description} {keywords} {url} {imageOG} {imagetwt}>
	<AboutPage  client:load/>
</ProtectedLayout>
